{
  "name": "caccia-alle-parole",
  "version": "2.0.1",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "apps/workers/*"
  ],
  "scripts": {
    "dev": "bun run dev:mobile",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:push-api": "bun run --cwd apps/workers/push-api dev",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "web:mobile": "bun run --cwd apps/mobile web",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "preview:web": "bun run --cwd apps/web preview",
    "lint:mobile": "bun run --cwd apps/mobile lint",
    "test:mobile": "bun run --cwd apps/mobile test -- --run",
    "validate:daily-catalog": "bun run --cwd apps/mobile validate:daily-catalog",
    "deploy:web": "bun run --cwd apps/web cf:deploy",
    "deploy:push-api": "bun run --cwd apps/workers/push-api deploy",
    "migrate:push-api": "bun run --cwd apps/workers/push-api migrate"
  }
}
